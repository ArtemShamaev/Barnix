// Классика
int fib(int n):
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

void main():
    var name = "World"
    string greeting = "Hello, " + name + "!"
    print(greeting)

    for i in 0..10:
        print("fib(" + i + ") = " + fib(i))

    // строки сравниваются по значению — никаких .equals()
    var a = "no" + "va"
    var b = "nova"
    if a == b:
        print("a == b: строки равны, как и должно быть")

    var x = 7 / 2       // int
    var y = 7 / 2.0     // double
    print("7 / 2 = " + x + ", 7 / 2.0 = " + y)
